{
  "$description": "Ember design tokens, the single source for tokens.css and flutter/ember_tokens.dart. Edit here, then run `node brand/tools/build.mjs`. Colour groups have a dark and a light value that share one name (The Same Room Rule).",
  "color": {
    "canvas":          { "$type": "color", "$description": "Night Desk: the page itself (top bar, rail, main column, status bar)", "dark": "#0c0c0e", "light": "#f7f6f3" },
    "panel":           { "$type": "color", "$description": "Shelf: docked side panels and in-page panels", "dark": "#121215", "light": "#efede9" },
    "raised":          { "$type": "color", "$description": "Lifted Card: inputs, cards, menus, toasts, monograms", "dark": "#18181c", "light": "#ffffff" },
    "hover":           { "$type": "color", "$description": "Row and button hover", "dark": "#1f1f24", "light": "#e6e3de" },
    "press":           { "$type": "color", "$description": "Pressed state", "dark": "#26262c", "light": "#dcd8d1" },
    "hairline":        { "$type": "color", "$description": "Divides regions", "dark": "rgba(255,255,255,.07)", "light": "rgba(30,24,16,.09)" },
    "hairline-strong": { "$type": "color", "$description": "Outlines controls, chips and floating layers", "dark": "rgba(255,255,255,.12)", "light": "rgba(30,24,16,.15)" },
    "ink":             { "$type": "color", "$description": "Primary text", "dark": "#e8e6e1", "light": "#1d1b18" },
    "ink-secondary":   { "$type": "color", "$description": "Controls and secondary text", "dark": "#aaa69f", "light": "#565149" },
    "ink-tertiary":    { "$type": "color", "$description": "Meta, labels, counts", "dark": "#87837c", "light": "#6c675e" },
    "prose":           { "$type": "color", "$description": "Long-form serif text, a half-step softer than ink", "dark": "#dcd9d2", "light": "#2a2722" },
    "accent":          { "$type": "color", "$description": "Ember: the one accent, as a fill", "dark": "#e9a14b", "light": "#d98a2b" },
    "accent-text":     { "$type": "color", "$description": "Ember Text: accent as text or icon (readable on canvas)", "dark": "#eeab5c", "light": "#8a4c05" },
    "accent-ink":      { "$type": "color", "$description": "Text on an accent fill", "dark": "#1a1206", "light": "#1d1206" },
    "accent-soft":     { "$type": "color", "$description": "Ember Glow: selected fills, focus halo", "dark": "rgba(233,161,75,.13)", "light": "rgba(217,138,43,.14)" },
    "accent-line":     { "$type": "color", "$description": "Ember Thread: selected borders, underlines", "dark": "rgba(233,161,75,.42)", "light": "rgba(186,108,18,.5)" },
    "focus":           { "$type": "color", "$description": "2px keyboard focus outline", "dark": "#e9a14b", "light": "#8a4c05" },
    "ok":              { "$type": "color", "$description": "Saved dot only", "dark": "#6fcf8e", "light": "#2f9a57" },
    "warn-bg":         { "$type": "color", "dark": "rgba(232,128,92,.08)", "light": "#fbeee6" },
    "warn-line":       { "$type": "color", "dark": "rgba(232,128,92,.28)", "light": "#efc6b0" },
    "warn-ink":        { "$type": "color", "dark": "#f0b49a", "light": "#8a3d1c" },
    "warn-strong":     { "$type": "color", "dark": "#f7d0bd", "light": "#6e2d10" },
    "err-bg":          { "$type": "color", "dark": "rgba(240,96,96,.08)", "light": "#fbeaea" },
    "err-line":        { "$type": "color", "dark": "rgba(240,96,96,.3)", "light": "#efbcbc" },
    "err-ink":         { "$type": "color", "dark": "#f3a3a0", "light": "#9b2420" },
    "segment-on":      { "$type": "color", "$description": "Selected option inside a segmented control", "dark": "#26262c", "light": "#ffffff" },
    "scrim":           { "$type": "color", "$description": "Behind modal palette and narrow drawer", "dark": "rgba(0,0,0,.4)", "light": "rgba(30,24,16,.18)" }
  },
  "shadow": {
    "float":  { "$type": "shadow", "$description": "Only for things that float: menus, palette, toasts, tooltips, overlay sheets",
                "dark":  [{ "x": 0, "y": 12, "blur": 32, "color": "rgba(0,0,0,.5)" }, { "x": 0, "y": 2, "blur": 6, "color": "rgba(0,0,0,.35)" }],
                "light": [{ "x": 0, "y": 12, "blur": 32, "color": "rgba(40,30,20,.14)" }, { "x": 0, "y": 2, "blur": 6, "color": "rgba(40,30,20,.08)" }] },
    "seated": { "$type": "shadow", "$description": "The selected segment",
                "dark":  [{ "x": 0, "y": 1, "blur": 2, "color": "rgba(0,0,0,.25)" }],
                "light": [{ "x": 0, "y": 1, "blur": 2, "color": "rgba(29,27,24,.12)" }] }
  },
  "font": {
    "sans":  { "$type": "fontFamily", "$value": ["Geist", "system-ui", "sans-serif"] },
    "serif": { "$type": "fontFamily", "$value": ["Literata", "Georgia", "serif"] },
    "mono":  { "$type": "fontFamily", "$value": ["ui-monospace", "Cascadia Mono", "Consolas", "monospace"] }
  },
  "type": {
    "display":     { "$type": "typography", "$value": { "family": "serif", "size": 30, "weight": 500, "lineHeight": 1.2, "letterSpacing": "-0.015em" } },
    "headline":    { "$type": "typography", "$value": { "family": "serif", "size": 22, "weight": 500, "lineHeight": 1.25, "letterSpacing": "-0.01em" } },
    "title":       { "$type": "typography", "$value": { "family": "serif", "size": 19, "weight": 500, "lineHeight": 1.2, "letterSpacing": "-0.01em" } },
    "prose":       { "$type": "typography", "$value": { "family": "serif", "size": 17, "weight": 400, "lineHeight": 1.75 } },
    "prose-small": { "$type": "typography", "$value": { "family": "serif", "size": 14, "weight": 400, "lineHeight": 1.6 } },
    "body":        { "$type": "typography", "$value": { "family": "sans", "size": 13, "weight": 400, "lineHeight": 1.45, "tabularFigures": true } },
    "ui-heading":  { "$type": "typography", "$value": { "family": "sans", "size": 13, "weight": 600, "lineHeight": 1.45 } },
    "control":     { "$type": "typography", "$value": { "family": "sans", "size": 12.5, "weight": 500, "lineHeight": 1.45 } },
    "label":       { "$type": "typography", "$value": { "family": "sans", "size": 11.5, "weight": 500, "lineHeight": 1.45 } },
    "mono":        { "$type": "typography", "$value": { "family": "mono", "size": 14, "weight": 400, "lineHeight": 1.7 } }
  },
  "radius": {
    "s":    { "$type": "dimension", "$value": 6 },
    "m":    { "$type": "dimension", "$value": 8 },
    "l":    { "$type": "dimension", "$value": 12 },
    "pill": { "$type": "dimension", "$value": 999 }
  },
  "space": {
    "xs":  { "$type": "dimension", "$value": 4 },
    "sm":  { "$type": "dimension", "$value": 8 },
    "md":  { "$type": "dimension", "$value": 12 },
    "lg":  { "$type": "dimension", "$value": 16 },
    "xl":  { "$type": "dimension", "$value": 24 },
    "2xl": { "$type": "dimension", "$value": 32 }
  },
  "size": {
    "control":       { "$type": "dimension", "$description": "Button, icon button", "$value": 28 },
    "control-large": { "$type": "dimension", "$value": 34 },
    "segment":       { "$type": "dimension", "$value": 24 },
    "chip":          { "$type": "dimension", "$value": 24 },
    "row":           { "$type": "dimension", "$description": "Sidebar/list row minimum height", "$value": 30 },
    "top-bar":       { "$type": "dimension", "$value": 44 },
    "status-bar":    { "$type": "dimension", "$value": 28 },
    "rail":          { "$type": "dimension", "$value": 52 },
    "sidebar":       { "$type": "dimension", "$value": 268 },
    "inspector":     { "$type": "dimension", "$value": 352 },
    "icon":          { "$type": "dimension", "$value": 16 },
    "icon-stroke":   { "$type": "dimension", "$value": 1.6 }
  },
  "motion": {
    "panel-duration": { "$type": "duration", "$description": "The only animated family: panels slide, stretch, collapse", "$value": "200ms" },
    "panel-ease":     { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1] }
  }
}
