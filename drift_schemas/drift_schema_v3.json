      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"preferences\" (\"id\" INTEGER NOT NULL, \"payload\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
