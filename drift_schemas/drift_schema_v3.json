          "sql": "CREATE TABLE IF NOT EXISTS \"pin_records\" (\"map_id\" TEXT NOT NULL, \"pin_id\" TEXT NOT NULL, \"payload\" TEXT NOT NULL, PRIMARY KEY (\"map_id\", \"pin_id\"));"
        }
      ]
    },
    {
      "name": "activity_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"activity_records\" (\"item_id\" TEXT NOT NULL, \"mode\" TEXT NOT NULL, \"source\" TEXT NOT NULL, \"observed_at\" INTEGER NOT NULL, \"revision\" INTEGER NOT NULL, PRIMARY KEY (\"item_id\", \"mode\"));"
        }
      ]
    },
    {
      "name": "catalog_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"catalog_records\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"cache_key\" TEXT NOT NULL, \"revision\" TEXT NOT NULL, \"payload\" TEXT NOT NULL, UNIQUE (\"cache_key\", \"revision\"));"
        }
      ]
    },
    {
      "name": "active_catalogs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"active_catalogs\" (\"cache_key\" TEXT NOT NULL, \"record_id\" INTEGER NOT NULL REFERENCES catalog_records (id), PRIMARY KEY (\"cache_key\"));"
        }
      ]
    },
    {
      "name": "import_records",
