      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"item_icon_records\" (\"item_id\" TEXT NOT NULL, \"icon_link\" TEXT NOT NULL, \"file_name\" TEXT NULL, \"byte_size\" INTEGER NOT NULL DEFAULT 0, \"etag\" TEXT NULL, \"validated_at\" INTEGER NULL, \"last_shown_at\" INTEGER NOT NULL, \"failed_until\" INTEGER NULL, \"failed_link\" TEXT NULL, PRIMARY KEY (\"item_id\"));"
